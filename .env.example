# Optional: copy to .env only when you want to customize these defaults.
# Docker Compose works without a .env file.

# Host ports
GATEWAY_PORT=8000

# Total Coordinator request deadline across sequential plan steps, in milliseconds
COORDINATOR_TIMEOUT_MS=25000

# Maximum duration of one Agent Card discovery or A2A task call, in milliseconds
AGENT_CALL_TIMEOUT_MS=10000

# Structured application log level: trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# PostgreSQL superuser password, applied when the data volume is initialized
POSTGRES_PASSWORD=postgres_demo_password

# Demo API keys and application DB role passwords remain in kong/kong.yml and db/init.sql.
